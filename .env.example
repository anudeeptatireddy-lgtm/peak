# Copy this file to .env and fill in what you need. Both are optional while building locally.

# The site's public address once it's online (for example https://peak.example.com).
# Used for canonical URLs, the sitemap and RSS. Leave empty locally.
PUBLIC_SITE_URL=

# Optional form where visitors can say a prompt didn't work (PRD §20). Leave empty to disable.
PUBLIC_FEEDBACK_URL=
