---
// A clearly marked placeholder for pages that later waves build.
interface Props {
  title: string;
  lede: string;
  wave: number;
}
const { title, lede, wave } = Astro.props;
---

<section class="placeholder wrap">
  <h1 class="display">{title}</h1>
  <p class="body measure">{lede}</p>
  <p class="small soft">This page is still being built. It arrives in wave {wave} of the build.</p>
</section>

<style>
  .placeholder {
    display: grid;
    gap: 1rem;
    align-content: center;
    min-height: 70vh;
    min-height: 70svh;
    padding-top: calc(var(--header-h) + 3rem);
    padding-bottom: 3rem;
  }
</style>
