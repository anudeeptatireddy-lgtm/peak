---
// The document shell every page uses. `world` picks the starting theme:
// 'riso' follows the system light/dark setting (content pages), a world id pins
// that world (scene pages), and 'journey' lets the page drive the theme itself.
import '../styles/global.css';
import { themeVars } from '../theme/apply';
import { getWorld, type WorldId } from '../theme/worlds';
import { INDEXABLE } from '../site';
import Analytics from '@vercel/analytics/astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  world?: Exclude<WorldId, 'custom'> | 'journey';
  /** Header and footer. Dev pages can turn them off. */
  chrome?: boolean;
  noindex?: boolean;
  /** Share image path under /og/ (defaults to the generic one). */
  image?: string;
}

const {
  title,
  description = 'Animations you can play with, plus the exact prompt to make your own with Claude Code.',
  world = 'riso',
  chrome = true,
  noindex = false,
  image = '/og/default.png',
} = Astro.props;

// Pinned worlds render their colors inline so the first paint is already right.
const initialWorld = world === 'journey' ? 'dreamhouse' : world;
const inlineVars =
  initialWorld === 'riso'
    ? undefined
    : Object.entries(themeVars(getWorld(initialWorld)))
        .map(([k, v]) => `${k}: ${v}`)
        .join('; ');
const canonical = Astro.site
  ? new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site).href
  : undefined;
const imageUrl = Astro.site ? new URL(image, Astro.site).href : image;
const pageTitle = title === 'peak' ? 'peak' : `${title} · peak`;
// Vercel Web Analytics (page views only, no cookies) loads only on Vercel builds,
// so local previews and tests never request the analytics script.
const onVercel = process.env.VERCEL === '1';
---

<!doctype html>
<html lang="en" style={inlineVars} data-world-mode={world}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="peak" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {(noindex || !INDEXABLE) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anybody:ital,wdth,wght@0,50..150,100..900;1,50..150,100..900&display=swap"
    />
    {onVercel && <Analytics />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    {chrome && <Header />}
    <main id="main">
      <slot />
    </main>
    {chrome && <Footer />}
    <script>
      import { onPausedChange } from '../engine/motion';
      import { connectThemeToCss } from '../theme/client';
      import { startLivingColors } from '../theme/living';
      import { followSystemRiso, setTheme } from '../theme/store';
      import { getWorld, isWorldId } from '../theme/worlds';

      const mode = document.documentElement.dataset.worldMode ?? 'riso';
      if (mode === 'riso') followSystemRiso();
      else if (isWorldId(mode)) setTheme(getWorld(mode));
      connectThemeToCss();
      startLivingColors();
      // Lets CSS loops (How it works illustrations) pause with everything else.
      onPausedChange((p) => (document.documentElement.dataset.paused = String(p)));
    </script>
  </body>
</html>
